---
// A page of its own in the landing page's frame (the bordered sheet on the surface colour), with
// the site header, search and footer: /addons, /benchmarks, /roadmap.
import Base from "./Base.astro";
import Header from "../components/site/Header.astro";
import SearchPalette from "../components/site/SearchPalette.astro";
import Footer from "../components/site/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** The header link this page is (its label). */
  current: string;
}

const { title, description, current } = Astro.props;
---

<Base title={title} description={description}>
  <Header current={current} />
  <SearchPalette />

  <div class="bg-surface pb-10 sm:px-[3%] sm:pt-6">
    <main id="main" class="mx-auto max-w-[1400px] border-border bg-background sm:border">
      <slot />
      <Footer />
    </main>
  </div>
</Base>
