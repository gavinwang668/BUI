---
// The looping "infinite tiling" animation: square panels sized by the golden ratio zoom endlessly into a
// spiral. Ported from zopra-website (app/components/landing/bento.tsx, ZopraPanels), drawn with Blender's
// theme colours (--primary blue and --accent orange) instead of purple. It draws only while on screen and shows
// one still frame for prefers-reduced-motion.
---

<div class="panels-loop" data-panels-loop role="img" aria-label="Looping animation: square panels sized by the golden ratio zoom endlessly into a spiral.">
  <svg aria-hidden="true">
    <defs>
      <filter id="panels-glow" filterUnits="userSpaceOnUse" x="-600" y="-600" width="1400" height="1400">
        <feGaussianBlur in="SourceGraphic" stdDeviation="2.2" result="b"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="b"></feMergeNode>
          <feMergeNode in="b"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>
    <g data-dyn></g>
  </svg>
</div>

<style>
  .panels-loop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    --zi-line: color-mix(in oklab, var(--foreground) 72%, transparent);
    --zi-detail: color-mix(in oklab, var(--foreground) 20%, transparent);
    --zi-front: var(--background);
    --zi-accent: var(--primary);
    --zi-hi: var(--accent); /* Blender orange: the comet, the lit panels' edge and the centre point */
  }
  .panels-loop svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .panels-loop :global(.zi-p) {
    fill: var(--zi-front);
    stroke: var(--zi-line);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .panels-loop :global(.zi-d) {
    fill: none;
    stroke: var(--zi-detail);
    stroke-width: 1;
    stroke-linecap: square;
    vector-effect: non-scaling-stroke;
  }
  .panels-loop :global(.zi-pl) {
    fill: var(--zi-accent);
    fill-opacity: 0.5;
    stroke: var(--zi-hi);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .panels-loop :global(.zi-arc) {
    fill: none;
    stroke: var(--zi-accent);
    stroke-width: 1.3;
    opacity: 0.85;
    vector-effect: non-scaling-stroke;
  }
  .panels-loop :global(.zi-comet) {
    fill: none;
    stroke: var(--zi-hi);
    stroke-width: 2.6;
    stroke-linecap: square;
    vector-effect: non-scaling-stroke;
  }
  .panels-loop :global(.zi-pt) {
    fill: var(--zi-hi);
  }
  .panels-loop :global(.zi-ring) {
    fill: none;
    stroke: var(--zi-hi);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
</style>

<script>
  const PHI = (1 + Math.sqrt(5)) / 2;
  const DEN = 1 + 1 / (PHI * PHI);
  const CX = PHI / DEN;
  const CY = 1 / DEN;
  const K0 = -6;
  const K1 = 13;
  const PER = 5.5; // seconds per zoom cycle
  const ARC = "M0 1A1 1 0 0 1 1 0";
  const n1 = (v: number) => Math.round(v * 10) / 10;
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const VIEW_BOX = `${n1(CX * 100 - 140)} ${n1(CY * 100 - 105)} 280 210`;

  function frame(t: number, dyn: SVGGElement) {
    const cyc = Math.floor(t / PER);
    const u = (t - cyc * PER) / PER;
    let sq = "";
    let lit = "";
    let arcs = "";
    let comets = "";
    const tail = 250 - 1000 * u;

    for (let k = K0; k <= K1; k++) {
      const kap = k - u;
      const side = Math.pow(PHI, -kap);
      const fade = clamp01((side - 0.004) / 0.008);
      if (fade <= 0.01) continue;
      const cx = n1(CX * 1e4) / 1e4;
      const cy = n1(CY * 1e4) / 1e4;
      const g = `translate(${cx} ${cy}) rotate(${n1(90 * kap * 100) / 100}) scale(${side.toFixed(5)}) translate(${-cx} ${-cy})`;
      const heat = Math.exp(-Math.pow((kap - 2.6) / 0.85, 2));

      sq += `<g transform="${g}" opacity="${fade.toFixed(2)}"><rect class="zi-p" width="1" height="1" />`;
      if (side > 0.06) {
        sq +=
          `<rect class="zi-d" x=".06" y=".06" width=".88" height=".88" />` +
          `<path class="zi-d" d="M.06 .2H.94M.14 .34H.62M.14 .44H.48"/><circle class="zi-d" cx=".12" cy=".13" r=".022"/>`;
      }
      sq += `</g>`;

      if (heat > 0.03) lit += `<g transform="${g}" opacity="${(fade * heat).toFixed(2)}"><rect class="zi-pl" width="1" height="1" /></g>`;

      arcs += `<g transform="${g}" opacity="${fade.toFixed(2)}"><path class="zi-arc" d="${ARC}"/></g>`;
      comets +=
        `<g transform="${g}" opacity="${fade.toFixed(2)}">` +
        `<path class="zi-comet" d="${ARC}" pathLength="1000" stroke-dasharray="250 2000" stroke-dashoffset="${n1(250 - 1000 * u)}"/>` +
        (tail > 0
          ? `<path class="zi-comet" d="${ARC}" pathLength="1000" stroke-dasharray="${n1(tail)} 3000" stroke-dashoffset="${n1(tail - 1000)}"/>`
          : "") +
        `</g>`;
    }

    const px = CX * 100;
    const py = CY * 100;
    dyn.innerHTML =
      `<g transform="scale(100)">${sq}</g>` +
      `<g filter="url(#panels-glow)"><g transform="scale(100)">${lit}${arcs}${comets}</g>` +
      `<circle class="zi-pt" cx="${n1(px)}" cy="${n1(py)}" r="2.2"/>` +
      `<circle class="zi-ring" cx="${n1(px)}" cy="${n1(py)}" r="${n1(2.5 + 11 * u)}" opacity="${n1((1 - u) * 100) / 100}"/></g>`;
  }

  document.querySelectorAll<HTMLElement>("[data-panels-loop]").forEach((host) => {
    const svg = host.querySelector("svg")!;
    const dyn = host.querySelector<SVGGElement>("[data-dyn]")!;
    svg.setAttribute("viewBox", VIEW_BOX);
    svg.setAttribute("preserveAspectRatio", "xMidYMid slice");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      frame(PER * 0.4, dyn);
      return;
    }
    let on = false;
    let raf = 0;
    const t0 = performance.now();
    const step = (now: number) => {
      frame((now - t0) / 1000, dyn);
      raf = on ? requestAnimationFrame(step) : 0;
    };
    // Draw only while on screen.
    new IntersectionObserver(([e]) => {
      on = e.isIntersecting;
      if (on && !raf) raf = requestAnimationFrame(step);
    }).observe(host);
  });
</script>
